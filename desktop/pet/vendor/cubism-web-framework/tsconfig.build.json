{
  "extends": "./tsconfig.upstream.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "../Core/*.d.ts"]
}
